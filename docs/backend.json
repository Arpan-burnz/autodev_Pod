
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information within the AutoDev Pod application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "externalUserId": {
          "type": "string",
          "description": "Unique identifier from the auth system."
        },
        "username": {
          "type": "string",
          "description": "Display name."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "externalUserId",
        "username",
        "email",
        "createdAt"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents an AI-powered development pod execution.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "idea": { "type": "string" },
        "status": { "type": "string", "enum": ["idle", "working", "completed", "error"] },
        "requirements": { "type": "object" },
        "architecture": { "type": "object" },
        "code": { "type": "object" },
        "qa": { "type": "object" },
        "devops": { "type": "object" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "ownerId", "idea", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com",
      "github.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile information.",
          "params": [
            {
              "name": "userId",
              "description": "Matching request.auth.uid."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/backend/entities/Project"
          },
          "description": "Represents an AI-powered development pod owned by a specific user.",
          "params": [
            {
              "name": "userId",
              "description": "Owner UID."
            },
            {
              "name": "projectId",
              "description": "Project UID."
            }
          ]
        }
      }
    ],
    "reasoning": "Standard hierarchical structure for user-owned projects."
  }
}
